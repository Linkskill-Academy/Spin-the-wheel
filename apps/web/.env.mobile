# Used only when building the web app for the Android (Capacitor) shell.
# Vite loads this automatically for `vite build --mode mobile`.
#
# The Capacitor webview cannot reach relative "/api" (its origin is https://localhost,
# not the dev machine), so mobile builds need an absolute backend URL instead.
#
# Set this to the Windows dev machine's LAN IPv4 address (find it with `ipconfig`) and the
# server's port. It must change if the machine's IP changes (e.g. reconnecting to Wi-Fi).
VITE_API_URL=http://10.207.155.8:4000
