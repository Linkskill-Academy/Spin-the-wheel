{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@mecrm/types": ["../../packages/types/src/index.ts"],
      "@mecrm/shared": ["../../packages/shared/src/index.ts"],
      "@mecrm/ui": ["../../packages/ui/src/index.tsx"]
    }
  },
  "include": ["src"]
}
