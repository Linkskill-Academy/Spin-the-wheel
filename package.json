{
  "name": "manifestation-execution-crm",
  "private": true,
  "version": "1.0.0",
  "description": "Manifestation & Execution CRM - a simple, positive, execution-first personal operating system",
  "workspaces": [
    "server",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:server": "npm run build --workspace=server",
    "build:extension": "npm run build --workspace=apps/extension",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
